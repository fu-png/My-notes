# ============================================================
# MyNotes 生产环境配置
# 复制此文件为 .env.production 并填入你的值:
#   cp .env.production.example .env.production
# ============================================================

# ---------- 数据库 ----------
POSTGRES_USER=mynotes
POSTGRES_PASSWORD=这里换成一个强密码       # 必填！
POSTGRES_DB=mynotes_prod

# ---------- JWT 密钥 ----------
# 用以下命令生成: openssl rand -base64 32
JWT_ACCESS_SECRET=这里换成随机生成的密钥    # 必填！
JWT_REFRESH_SECRET=这里换成随机生成的密钥   # 必填！

# ---------- CORS ----------
# 设为你的前端域名，多个用逗号分隔
# 示例: https://my-notes.vercel.app
CORS_ORIGIN=*

# ---------- 端口 ----------
# Nginx 监听的宿主机端口
HTTP_PORT=80
