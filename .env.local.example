# ========================================
# Auth.js - 邮箱密码登录
# ========================================
# 生成方式: openssl rand -base64 33
AUTH_SECRET=your_random_secret_here

# 管理员邮箱和密码（只有这组凭据能登录）
ADMIN_EMAIL=admin@mynotes.com
ADMIN_PASSWORD=your_password_here

# ========================================
# Vercel Blob Storage
# ========================================
# 在 Vercel Dashboard 创建 Blob Store 后获取
# 本地开发可通过 `npx vercel env pull` 自动拉取
# 不配置则使用本地文件系统存储
BLOB_READ_WRITE_TOKEN=your_blob_token_here
