# ========================================
# Auth.js (NextAuth v5) - GitHub OAuth
# ========================================
# 1. 在 GitHub 创建 OAuth App: https://github.com/settings/developers
#    - Homepage URL: http://localhost:3000 (开发) 或你的域名 (生产)
#    - Authorization callback URL: http://localhost:3000/api/auth/callback/github
# 2. 将获得的 Client ID 和 Client Secret 填入下方

AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# 生成方式: openssl rand -base64 33
AUTH_SECRET=your_random_secret_here

# 允许登录的 GitHub 用户名（逗号分隔，为空则允许所有人）
ALLOWED_GITHUB_USERS=your_github_username

# ========================================
# Vercel Blob Storage
# ========================================
# 在 Vercel Dashboard 创建 Blob Store 后获取
# 本地开发可通过 `npx vercel env pull` 自动拉取
BLOB_READ_WRITE_TOKEN=your_blob_token_here
