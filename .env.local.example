# ========================================
# Vercel Blob Storage
# ========================================
# 在 Vercel Dashboard 创建 Blob Store 后获取
# 本地开发可通过 `npx vercel env pull` 自动拉取
# 不配置则使用本地文件系统存储
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# ========================================
# Tavily Search API (联网搜索)
# ========================================
# 在 https://app.tavily.com 注册获取免费 API Key（每月 1000 次免费搜索）
# AI 助手的联网搜索功能依赖此配置
TAVILY_API_KEY=tvly-your_api_key_here
